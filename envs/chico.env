
PROJECT_NAME=voice-edge-usb
AUDIO_EXTS=.wav,.mp3,.m4a
INBOX_DIR=storage/inbox
PROCESSED_DIR=storage/processed
FAILED_DIR=storage/failed
MANIFESTS_DIR=storage/manifests
UPLOAD_CACHE=storage/uploads
CONCURRENCY=2
REQUIRE_AUDIO_FILE=false

