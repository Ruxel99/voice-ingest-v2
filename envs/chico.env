DELETE_FROM_DEVICE_AFTER_COPY=true
DELETE_LOCAL_AFTER_POST=true
STRICT_SCAN_ONLY=false
EXTRA_SCAN_DIRS=D:\RECORD
EVISTR_LABEL=L357       # nombre del volumen (como aparece en el explorador)
EVISTR_SUBDIR=RECORD    # carpeta dentro del USB donde están los audios
